{
  "name": "emotional-fitness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "astro dev",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787",
    "build": "astro build",
    "build:guide": "node guide/build-pdf.mjs",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check && tsc -p server"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261018.1",
    "@tailwindcss/vite": "4.1.17",
    "astro": "7.4.0",
    "concurrently": "10.0.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
