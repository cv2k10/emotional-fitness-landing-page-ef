---
import Brand from "./Brand.astro";
import ArrowRight from "./icons/ArrowRight.astro";
---

<header class="site-header">
  <div class="header-inner">
    <Brand label="Emotional Fitness, home" />

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
      <a href="#approach">The approach</a>
      <a href="#guide">Free guide</a>
      <a href="#workshop">Workshop</a>
      <a href="#support">One-to-one</a>
      <a class="header-cta" href="#workshop" data-conversion="workshop_header_cta">
        Explore the workshop <ArrowRight />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const nav = header.querySelector<HTMLElement>(".main-nav")!;

  const setMenuOpen = (open: boolean) => {
    toggle.classList.toggle("is-open", open);
    nav.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
  };

  toggle.addEventListener("click", () => setMenuOpen(!nav.classList.contains("is-open")));
  header.querySelectorAll(".brand, .main-nav a").forEach((link) =>
    link.addEventListener("click", () => setMenuOpen(false)),
  );
</script>
