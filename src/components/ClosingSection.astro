---
import ArrowRight from "./icons/ArrowRight.astro";
---

<section class="closing-section" aria-labelledby="closing-title">
  <div class="page-width closing-inner" data-reveal>
    <p class="eyebrow">The person behind the performance matters.</p>
    <h2 id="closing-title">Make space for a stronger inner life.</h2>
    <a class="button button-primary" href="#workshop" data-conversion="workshop_closing_cta">
      Explore the workshop <ArrowRight />
    </a>
  </div>
  <span class="closing-orbit closing-orbit-one" aria-hidden="true"></span>
  <span class="closing-orbit closing-orbit-two" aria-hidden="true"></span>
</section>
