---
import ArrowRight from "./icons/ArrowRight.astro";
---

<section class="workshop-section section-pad" id="workshop" aria-labelledby="workshop-title">
  <div class="page-width workshop-layout">
    <div class="workshop-copy" data-reveal>
      <p class="eyebrow section-eyebrow">04 / Start with a small step</p>
      <h2 id="workshop-title">
        Take your first practical step towards emotional fitness.
      </h2>
      <p class="workshop-description">
        An introductory workshop is a chance to experience the approach,
        explore where it meets your working life, and decide what feels
        useful to take forward.
      </p>
      <div class="outcomes-note">
        <span class="outcomes-note-number">A / B</span>
        <div>
          <p>Learning outcomes</p>
          <span>To be confirmed by the programme owner before registration opens.</span>
        </div>
      </div>
    </div>

    <aside class="workshop-panel" data-reveal aria-label="Introductory workshop details">
      <p class="eyebrow workshop-panel-eyebrow">INTRODUCTORY WORKSHOP</p>
      <h3>Workshop title <span>to be confirmed</span></h3>
      <p class="workshop-panel-copy">
        A welcoming, practical introduction to the emotional fitness approach.
      </p>
      <dl class="workshop-details">
        <div>
          <dt>Duration</dt>
          <dd>2.5 hours</dd>
        </div>
        <div>
          <dt>Delivery</dt>
          <dd>Live online</dd>
        </div>
        <div>
          <dt>Date</dt>
          <dd>Thu 19 Nov 2026</dd>
        </div>
        <div>
          <dt>Investment</dt>
          <dd>£95</dd>
        </div>
      </dl>
      <button class="button button-primary workshop-button" type="button" data-open-dialog="workshop">
        Register your interest <ArrowRight />
      </button>
      <p class="workshop-panel-footnote">
        Sample details shown for this demo site.
      </p>
    </aside>
  </div>
</section>
