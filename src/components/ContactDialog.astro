---
import ArrowRight from "./icons/ArrowRight.astro";
---

<dialog class="contact-dialog" aria-labelledby="dialog-title">
  <div class="dialog-content">
    <button class="dialog-close" type="button" aria-label="Close dialog" data-close-dialog>
      <span></span>
      <span></span>
    </button>
    <p class="eyebrow section-eyebrow" data-dialog-eyebrow></p>
    <h2 id="dialog-title" data-dialog-title></h2>
    <p class="dialog-description" data-dialog-description></p>

    <form class="dialog-form">
      <label class="field-label">
        First name
        <input autocomplete="given-name" name="firstName" required />
      </label>
      <label class="field-label">
        Email address
        <input autocomplete="email" name="email" type="email" required />
      </label>
      <label class="consent-label dialog-consent">
        <input name="contactConsent" type="checkbox" required />
        <span>I agree to be contacted about this request.</span>
      </label>
      <p class="form-error" role="alert" hidden></p>
      <button class="button button-dark" type="submit">
        <span data-dialog-submit></span>
        <ArrowRight />
      </button>
    </form>

    <div class="dialog-success" role="status" aria-live="polite" hidden>
      <p class="guide-success-title">Thank you for your interest.</p>
      <p>
        Your request has been received. You&apos;ll hear back by email
        once availability is confirmed.
      </p>
      <button class="text-link dialog-return" type="button" data-close-dialog>
        Return to the page <ArrowRight />
      </button>
    </div>
  </div>
</dialog>

<script>
  import { dialogContent, type DialogKind } from "../data/content";
  import { recordConversion } from "../scripts/analytics";
  import { readContactForm, submitContact } from "../scripts/submit-contact";

  const dialog = document.querySelector<HTMLDialogElement>(".contact-dialog")!;
  const form = dialog.querySelector<HTMLFormElement>(".dialog-form")!;
  const success = dialog.querySelector<HTMLElement>(".dialog-success")!;
  const error = form.querySelector<HTMLElement>(".form-error")!;
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const slot = (name: string) => dialog.querySelector<HTMLElement>(`[data-dialog-${name}]`)!;

  let activeKind: DialogKind | null = null;

  const openDialog = (kind: DialogKind) => {
    const content = dialogContent[kind];
    activeKind = kind;
    slot("eyebrow").textContent = content.eyebrow;
    slot("title").textContent = content.title;
    slot("description").textContent = content.description;
    slot("submit").textContent = content.submit;
    form.dataset.track = `${kind}_interest_submit`;
    form.reset();
    form.hidden = false;
    success.hidden = true;
    error.hidden = true;
    if (!dialog.open) dialog.showModal();
    recordConversion(`${kind}_interest_open`);
  };

  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>("[data-open-dialog]");
    const kind = trigger?.dataset.openDialog;
    if (kind && kind in dialogContent) openDialog(kind as DialogKind);
  });

  dialog.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (target === dialog || target.closest("[data-close-dialog]")) dialog.close();
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!activeKind) return;
    const kind = activeKind;
    error.hidden = true;
    submitButton.disabled = true;
    try {
      await submitContact("/api/enquiries", { ...readContactForm(form, "contactConsent"), kind });
      form.hidden = true;
      success.hidden = false;
      recordConversion(`${kind}_interest_submit`);
    } catch (submitError) {
      error.textContent = (submitError as Error).message;
      error.hidden = false;
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
